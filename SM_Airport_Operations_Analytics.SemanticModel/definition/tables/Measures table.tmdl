table 'Measures table'
	lineageTag: 51caa5e7-c634-488e-a0d6-ed81841be56e

	measure 'Total Flights' =
			
			COUNTROWS(fact_flight_operations)
		formatString: 0
		displayFolder: Flight Operations\Performance
		lineageTag: dbd453fe-568e-4c88-b3d7-f058917c09f0

	measure 'Total Passengers' =
			
			SUM(fact_flight_operations[passenger_count])
		formatString: 0
		displayFolder: Flight Operations\Performance
		lineageTag: 3119a573-ed56-4b35-b77f-34bda911ed1e

	measure 'Total Seat Capacity' =
			
			SUM(fact_flight_operations[seat_capacity])
		formatString: 0
		displayFolder: Flight Operations\Performance
		lineageTag: 6f9d92a5-746e-41b0-bdde-93bb47c830c8

	measure 'Load Factor %' =
			
			DIVIDE([Total Passengers],[Total Seat Capacity],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Flight Operations\Performance
		lineageTag: f32a97b2-bf8e-4258-ac27-734990f42e58

	measure 'Delayed Flights' =
			
			CALCULATE([Total Flights], fact_flight_operations[status] = "Delayed")
		formatString: 0
		displayFolder: Flight Operations\Performance
		lineageTag: 55f62f10-78bd-4dd6-8f4e-77d68e02db6e

	measure 'Cancelled Flights' =
			
			CALCULATE(
			    [Total Flights],
			    fact_flight_operations[status] = "Cancelled"
			)
		formatString: 0
		displayFolder: Flight Operations\Performance
		lineageTag: 592ce008-f8b9-44a8-8d0c-0f59784a62c5

	measure 'On-Time Flights' =
			
			CALCULATE([Total Flights],fact_flight_operations[status] = "On Time")
		formatString: 0
		displayFolder: Flight Operations\Performance
		lineageTag: 99e61c6c-ea6d-442b-8907-1c71e4295740

	measure 'On-Time Performance %' =
			
			DIVIDE([On-Time Flights],[Total Flights],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Flight Operations\Performance
		lineageTag: 66719c93-a333-44b9-b49c-aa8872e8e53a

	measure 'Cancellation Rate %' =
			
			DIVIDE([Cancelled Flights],[Total Flights],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Flight Operations\Performance
		lineageTag: 81e38506-f49e-4de4-9b13-de32530774be

	measure 'Average Delay Minutes' =
			
			AVERAGE(fact_flight_operations[delay_minutes])
		displayFolder: Flight Operations\Performance
		lineageTag: cac79fd8-5593-4983-8185-dbb366f5f558

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Passengers Processed' =
			
			SUM(fact_passenger_flow[passengers_processed])
		formatString: 0
		displayFolder: Passenger Flow\Performance
		lineageTag: 8d3a5f44-0b8e-4b32-bdd9-3526696c5c22

	measure 'Average Security Wait Time' =
			
			DIVIDE(SUMX(fact_passenger_flow,fact_passenger_flow[avg_security_wait_min]*fact_passenger_flow[passengers_processed]),
			[Total Passengers Processed])
		displayFolder: Passenger Flow\Performance
		lineageTag: 7e8ff952-72a6-43bb-be70-66a9e5ed7d01

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Maximum Security Wait Time' = MAX(fact_passenger_flow[avg_security_wait_min])
		displayFolder: Passenger Flow\Performance
		lineageTag: 207409de-3bd2-455a-a363-267c368cf0c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Passengers per Hour' =
			
			AVERAGEX(
			    SUMMARIZE(
			        fact_passenger_flow,
			        fact_passenger_flow[date_key],
			        fact_passenger_flow[hour],
			        "HourlyPassengers",
			            SUM(fact_passenger_flow[passengers_processed])
			    ),
			    [HourlyPassengers]
			)
		formatString: 0
		displayFolder: Passenger Flow\Performance
		lineageTag: b44d50be-fd8a-42fb-bbb9-06d85e76d541

	measure 'Total Bags Processed' =
			
			SUM(fact_baggage_operations[bags_processed])
		formatString: 0
		displayFolder: Baggage Operations\Performance
		lineageTag: 6e3fbbe2-b2a1-4a0f-bd22-880db0b1c766

	measure 'Mishandled Bags' =
			
			SUM(fact_baggage_operations[mishandled_bags])
		formatString: 0
		displayFolder: Baggage Operations\Performance
		lineageTag: 3d18d869-8169-4452-a526-4b1b6f9db0b8

	measure 'Mishandled Baggage Rate %' = DIVIDE([Mishandled Bags],[Total Bags Processed],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Baggage Operations\Performance
		lineageTag: de9384f8-f8ec-465f-83a5-f1a161b62c2a

	measure 'Average First Bag Time' =
			
			AVERAGE(fact_baggage_operations[first_bag_min])
		displayFolder: Baggage Operations\Performance
		lineageTag: 6b2c5ac1-5010-4169-a708-b83601dba960

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Last Bag Time' =
			
			AVERAGE(fact_baggage_operations[last_bag_min])
		displayFolder: Baggage Operations\Performance
		lineageTag: 02fed913-ee55-4f3d-959c-b6f24f69f5ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Commercial Revenue' =
			
			SUM(fact_commercial_transactions[amount_cad])
		displayFolder: Commercial\Performance
		lineageTag: 1ff1dc4a-556e-4e4c-8fd9-98516361816f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Transactions' =
			
			COUNTROWS(fact_commercial_transactions)
		formatString: 0
		displayFolder: Commercial\Performance
		lineageTag: 138ae19d-3c58-4472-b5d5-66b54cc49565

	measure 'Average Transaction Value' =
			
			AVERAGE(fact_commercial_transactions[amount_cad])
		displayFolder: Commercial\Performance
		lineageTag: 4c6e50b0-4eed-4173-b0b1-2d87632b0e40

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Refund Adjustment Amount' =
			
			CALCULATE(
			    SUM(fact_commercial_transactions[amount_cad]),
			    fact_commercial_transactions[amount_cad] < 0
			)
		displayFolder: Commercial\Performance
		lineageTag: c1936e2e-d485-42d2-afa3-980ee04143d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Refund Adjustment Transactions' =
			
			CALCULATE(
			    [Total Transactions],
			    fact_commercial_transactions[amount_cad] < 0
			)
		formatString: 0
		displayFolder: Commercial\Performance
		lineageTag: aa7aee01-90b2-4588-9381-f78ce9095b51

	measure 'Refund Adjustment Rate %' =
			
			DIVIDE(
			    [Refund Adjustment Transactions],
			    [Total Transactions],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Commercial\Performance
		lineageTag: a9ac36ab-c1da-4691-9723-1c0f1e07a9c8

	measure 'Total Electricity Consumption' =
			
			SUM(fact_sustainability_daily[electricity_kwh])
		displayFolder: Sustainability\Performance
		lineageTag: d9cc5493-8f19-44e2-bc52-9c9a15d194d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Water Consumption' =
			
			SUM(fact_sustainability_daily[water_m3])
