		lineageTag: cd7b4e60-e550-4063-bc8a-33021aa305c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Daily Water Consumption' =
			
			AVERAGE(fact_sustainability_daily[water_m3])
		displayFolder: Sustainability\Performance
		lineageTag: efad411a-ff9d-42c5-9cf3-259c7e81e3f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Waste Generated' =
			
			SUM(fact_sustainability_daily[waste_tonnes])
		displayFolder: Sustainability\Performance
		lineageTag: 57be5bd6-1d07-4f0b-b45f-fe99e574fcc8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Estimated CO2e Emissions' =
			
			SUM(fact_sustainability_daily[estimated_co2e_tonnes])
