	measure 'Average Delay Variance' =
			
			[Average Delay Minutes] - [Average Delay Target]
		displayFolder: KPIs\Variance
		lineageTag: eba11c01-cf88-43c6-8096-fafcf047f972

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Delay Target Status' =
			
			IF(
			    [Average Delay Minutes] <= [Average Delay Target],
			    "Met",
			    "Not Met"
			)
		displayFolder: KPIs\Status
		lineageTag: 8d784820-5c03-41c7-854a-6c46d2a8b0ce

	measure 'On-Time Performance Variance' =
			
			[On-Time Performance %] - [On-Time Performance Target]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPIs\Variance
		lineageTag: b8feaa8d-581f-4830-b2db-3e81e42fb437

	measure 'On-Time Performance Target Status' =
			
			IF(
			    [On-Time Performance %] >= [On-Time Performance Target],
