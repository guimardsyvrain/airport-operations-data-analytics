	measure 'Total Feedback' =
			
			COUNTROWS(fact_passenger_flow)
		formatString: 0
		displayFolder: Passenger Feedback
		lineageTag: ec836a36-118e-4393-9653-c586009323da

	measure 'Undated Feedback' =
			
			CALCULATE([Total Feedback],ISBLANK(fact_passenger_feedback[date_key])
			)
		formatString: 0
		displayFolder: Passenger Feedback
		lineageTag: 81d6f952-757d-4f8f-9b76-fc922b06961f

	measure 'Feedback with Valid Date' =
			
			CALCULATE(
			    [Total Feedback],
			    NOT ISBLANK(fact_passenger_feedback[date_key])
			)
		formatString: 0
		displayFolder: Passenger Feedback
		lineageTag: ca104895-4742-4347-8960-69b2f504f6fe

	measure 'Dated Feedback Rate %' =
			
			DIVIDE([Feedback with Valid Date],[Total Feedback],0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Passenger Feedback
		lineageTag: b3bee2bf-9d44-433c-9961-de3310c816a3

	measure 'Revenue per Passenger' =
			
			DIVIDE([Total Commercial Revenue],[Total Passengers Processed],
			    0
			)
		formatString: #,0.00\ \$;(#,0.00\ \$);#,0.00\ \$
		displayFolder: Commercial\Performance
		lineageTag: db5d9935-589f-4cec-bd6b-6cdeda47aa91

		annotation PBI_FormatHint = {"currencyCulture":"fr-CA"}

	measure 'Energy per Passenger' =
			
			DIVIDE([Total Electricity Consumption],[Total Passengers Processed],
			    0
			)
		formatString: 0.00
		displayFolder: Sustainability\Performance
		lineageTag: a9bb9e37-721d-45df-9d2a-9c8a65d62ff3

	measure 'Average Delay Target' =
			
			VAR SelectedDate =
			    MAX(dim_date[date])
			RETURN
			    CALCULATE(
			        MAX(operational_targets[target_value]),
			        operational_targets[kpi_code] = "AVG_DELAY",
			        operational_targets[effective_start_date] <= SelectedDate,
			        ISBLANK(operational_targets[effective_end_date])
			            || operational_targets[effective_end_date] >= SelectedDate
			    )
		displayFolder: KPIs\Target
		lineageTag: 19f0a4b2-5c83-4868-8c30-a313899fd69b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'On-Time Performance Target' =
			
			VAR SelectedDate =
			    MAX(dim_date[date])
			RETURN
			    CALCULATE(
			        MAX(operational_targets[target_value]),
			        operational_targets[kpi_code] = "ON_TIME_PERFORMANCE",
			        operational_targets[effective_start_date] <= SelectedDate,
			        ISBLANK(operational_targets[effective_end_date])
			            || operational_targets[effective_end_date] >= SelectedDate
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPIs\Target
		lineageTag: ca7cd633-bea7-4792-9b2c-420ea3289c3e

